{
  "name": "nuqta",
  "productName": "Nuqta",
  "version": "0.1.0",
  "private": true,
  "description": "دفتر حسابات لشبكات الهوتسبوت على MikroTik",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "license:admin": "node scripts/license-admin.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "author": {
    "name": "mahmoudteirdev"
  },
  "homepage": "https://github.com/mahmoudteirdev/nuqta",
  "build": {
    "appId": "com.mahmoudteirdev.nuqta",
    "productName": "Nuqta",
    "copyright": "Copyright © 2026 mahmoudteirdev",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!out/**/*.map"
    ],
    "artifactName": "Nuqta-Setup-${version}.${ext}",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Nuqta",
      "icon": "build/icon.png",
      "cscLink": "build/nuqta-codesign.pfx",
      "cscKeyPassword": "NuqtaCodeSign2026"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nuqta",
      "uninstallDisplayName": "Nuqta",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/mahmoudteirdev/nuqta-releases/releases/latest/download"
      }
    ]
  }
}
